# Copy to .env and fill in from Supabase Dashboard > Project Settings > API Keys.
# Only the publishable key belongs in the app. Never put the secret / service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base URL of the hosted invite page (the web/ project), e.g. https://join.example.com/j
# The app appends ?c=<6-digit code>. Leave empty and invites carry the code only (no link).
EXPO_PUBLIC_INVITE_BASE_URL=

# Phone sign-in needs an SMS provider in Supabase (costs money). Set to 1 to show the Phone tab on
# Save account / Sign in. Anything else keeps email only.
EXPO_PUBLIC_PHONE_AUTH=

# Optional: OSRM route service base (no trailing slash). Defaults to the public demo server. Routes normally go through the
# `geo` Edge Function (LocationIQ); this URL is used when `geo` is not configured, and in a dev build it overrides `geo` outright.
EXPO_PUBLIC_ROUTING_URL=

# Set to 1 only if the router above honours `exclude=motorway` (a self-hosted OSRM with a profile that has
# motorways to exclude). The public demo rejects it, so leave empty there: the "Allow expressways" switch is
# hidden and no request carries `exclude`.
EXPO_PUBLIC_ROUTING_EXCLUDE=

# Release builds only: set to 1 to let routing use the OSRM URL above while the geo function has no LocationIQ key
# (a transition choice; the public demo is non-commercial). Dev builds always allow it. Unset: a failed route instead.
EXPO_PUBLIC_ROUTING_DEMO_FALLBACK=

# Dev builds only (ignored in release): act as if the geo function answered a limit.
# search_429 | search_quota | route_429_minute | route_429_day
EXPO_PUBLIC_GEO_SIMULATE=
