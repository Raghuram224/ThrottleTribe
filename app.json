{
  "expo": {
    "name": "Throttle Tribe",
    "slug": "throttle-tribe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.throttletribe.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.throttletribe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/png/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/png/android-icon-background.png",
        "backgroundColor": "#F97316",
        "monochromeImage": "./assets/brand/png/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Throttle Tribe shows your position to your riding group during a ride so everyone can see who is ahead or behind.",
          "locationAlwaysAndWhenInUsePermission": "During a ride, Throttle Tribe keeps sharing your position with your group while your phone is locked or in your pocket, so nobody loses track of you. Sharing stops when the ride ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F97316",
          "image": "./assets/brand/png/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0B0F14",
            "image": "./assets/brand/png/splash-icon-dark.png"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Throttle Tribe uses contacts only when you choose someone to invite or add as an emergency contact."
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "throttletribe",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/throttletribe/app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/brand/png/favicon.png",
      "name": "Throttle Tribe",
      "shortName": "Throttle Tribe",
      "description": "Group motorcycle ride tracking: see who is ahead, who is behind and who needs help.",
      "themeColor": "#F97316",
      "backgroundColor": "#0B0F14",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en"
    }
  }
}
